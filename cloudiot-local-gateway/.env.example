# CloudIoT 本地网关配置
# 复制为 .env 并修改

# HTTP 端口
HTTP_PORT=8080

# MQTT 端口
MQTT_PORT=1883

# 数据库路径
DB_PATH=./data/gateway.db

# Cloudflare 配置（留空 = 禁用云同步，仅本地网关模式）
CLOUD_API=
CLOUD_KEY=

# 同步间隔（秒）
SYNC_INTERVAL=30

# 数据保留天数
DATA_RETENTION_DAYS=180

# 设备自动注册
DEVICE_AUTO_REGISTER=true

# HTTP 设备无心跳判离线阈值（毫秒，默认 120000 = 2 分钟）
# DEVICE_HTTP_STALE_TTL_MS=120000

# 心跳扫描周期（毫秒，默认 30000 = 每 30 秒）
# DEVICE_HTTP_STALE_SCAN_INTERVAL_MS=30000

# 日志级别
LOG_LEVEL=info

# 网关 ID（自动生成）
# GATEWAY_ID=gateway-custom
