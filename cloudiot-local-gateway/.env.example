# CloudIoT 本地网关配置
# 复制为 .env 并修改

# HTTP 端口
HTTP_PORT=8080

# MQTT 端口
MQTT_PORT=1883

# 数据库路径
DB_PATH=./data/gateway.db

# Cloudflare 配置
CLOUD_API=https://your-worker.workers.dev
CLOUD_KEY=your-cloudflare-api-key

# 同步间隔（秒）
SYNC_INTERVAL=30

# 数据保留天数
DATA_RETENTION_DAYS=180

# 设备自动注册
DEVICE_AUTO_REGISTER=true

# 日志级别
LOG_LEVEL=info

# 网关 ID（自动生成）
# GATEWAY_ID=gateway-custom
